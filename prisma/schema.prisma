generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("PLAYER") // "ADMIN" or "PLAYER"
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  registrations Registration[]
}

model Tournament {
  id            String         @id @default(cuid())
  title         String
  type          String         // "solo", "duo", "squad"
  entryFee      Int
  prizePool     Int
  totalSlots    Int
  status        String         @default("OPEN") // "OPEN", "FILLING", "CLOSED"
  roomId        String?
  roomPassword  String?
  scheduledDate DateTime
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  registrations Registration[]
  matchResults  MatchResult[]
}

model Registration {
  id               String      @id @default(cuid())
  userId           String?     // Optional to not break old records, but all new ones will have it
  user             User?       @relation(fields: [userId], references: [id])
  tournamentId     String
  tournament       Tournament  @relation(fields: [tournamentId], references: [id])
  type             String      // "solo", "duo", "squad"
  teamName         String?
  captainName      String
  uid              String
  phone            String
  paymentProofUrl  String      // URL to the uploaded screenshot
  status           String      @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model MatchResult {
  id            String      @id @default(cuid())
  tournamentId  String
  tournament    Tournament  @relation(fields: [tournamentId], references: [id])
  teamName      String      // Can be Player Name for Solo, or Team Name for Duo/Squad
  uid           String      // Used to uniquely identify the player to fetch their stats
  kills         Int
  placement     Int
  totalScore    Int
  isQualified   Boolean     @default(false)
  createdAt     DateTime    @default(now())
}
